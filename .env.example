# ===========================================
# SQL Bridge MCP - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- MySQL Connection (required) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=sqlbridge
MYSQL_PASSWORD=your_secure_password
MYSQL_DATABASE=your_database

# --- Connection Pool (optional) ---
# Maximum number of connections in the pool (1-100)
MYSQL_CONNECTION_LIMIT=10

# Connection timeout in milliseconds (1000-60000)
MYSQL_CONNECT_TIMEOUT=10000

# Per-query execution timeout in milliseconds (1000-120000)
MYSQL_QUERY_TIMEOUT=30000

# --- Rate Limiting (optional) ---
# Maximum requests per time window (1-100)
RATE_LIMIT_MAX=10

# Time window in milliseconds (100-60000)
RATE_LIMIT_WINDOW_MS=1000
