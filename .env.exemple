# ============================================
# Configuration MySQL pour MCP Server
# ============================================
# Copiez ce fichier vers .env et remplissez vos valeurs

# Hôte MySQL (localhost pour développement local)
MYSQL_HOST=localhost

# Port MySQL (3306 par défaut)
MYSQL_PORT=3306

# Nom d'utilisateur MySQL
MYSQL_USER=root

# Mot de passe MySQL
MYSQL_PASSWORD=your_password_here

# Nom de la base de données
MYSQL_DATABASE=anelka_mcp # exemple: anelka_mcp
